# Enforce LF line endings for shell scripts on all platforms.
# Without this, Windows checkouts produce CRLF which breaks bash on Linux/macOS.
*.sh text eol=lf

# Lockfiles are generated: keep them in git, but leave them out of GitHub's
# language stats and collapse them in diffs.
package-lock.json linguist-generated=true
bun.lock linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
