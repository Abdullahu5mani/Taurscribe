<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- macOS: Required for microphone access (cpal audio capture) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Local ad-hoc bundles have no Team ID. Allow the bundled, verified ASR
         dylibs to load while keeping the rest of the hardened runtime enabled. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- macOS: lets the hardened runtime send Apple events (browser tab listing) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
