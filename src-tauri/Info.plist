<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- macOS: Usage description shown in the system permission dialog when the
         app first tries to access the microphone. Without this key, macOS
         silently denies microphone access and cpal gets no audio data. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Taurscribe needs microphone access to transcribe your speech into text.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Taurscribe records meeting audio from other apps so both you and the other participants appear in your recording.</string>
    <!-- macOS: shown when Taurscribe first lists a browser's tabs (AppleScript) to
         find which one holds a call. Without it the request is denied silently. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Taurscribe reads your browser's open tabs to recognize which one is a call, so it can name and record the meeting.</string>
</dict>
</plist>
