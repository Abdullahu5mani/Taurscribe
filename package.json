{
  "name": "taurscribe",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "bun test tests/frontend tests/bughunt",
    "test:harness": "scripts/harness/.venv/bin/python scripts/harness/run_unit_tests.py",
    "test:decider": "scripts/harness/run_decider_benchmark.sh",
    "test:native": "bun scripts/cargo-native.ts test --all-targets",
    "test:asr": "bun scripts/cargo-native.ts test --test jfk_asr_smoke -- --ignored --nocapture --test-threads=1",
    "test:playback": "bun scripts/cargo-native.ts test --test meeting_playback_stress -- --ignored --nocapture",
    "test:memory": "bun scripts/cargo-native.ts test --test memory_engine_regression -- --ignored --nocapture",
    "test:speakers": "bun scripts/cargo-native.ts test --test speaker_recognition_acceptance -- --ignored --nocapture",
    "tauri": "bun scripts/cargo-native.ts --tauri",
    "build:macos": "bun scripts/build-macos.ts",
    "build:windows": "bun scripts/build-windows.ts --bundles nsis",
    "build:windows:nvidia": "bun scripts/build-windows.ts --bundles nsis --features gpu-nvidia",
    "build:windows:online": "bun scripts/build-windows.ts --bundles nsis --features gpu-nvidia,gpu-vulkan --online-cuda",
    "build:windows:vulkan": "bun scripts/build-windows.ts --bundles nsis --features gpu-vulkan",
    "build:windows-portable": "npm run tauri build -- --target x86_64-pc-windows-msvc --config '{\"bundle\":{\"targets\":[\"nsis\"],\"windows\":{\"nsis\":{\"installMode\":\"portable\"}}}}'",
    "check": "bun scripts/cargo-native.ts check",
    "test:accessibility": "python3 scripts/tests/test_appium_accessibility.py",
    "check:e2e": "npx tsc --noEmit --target ES2020 --module ESNext --moduleResolution bundler --skipLibCheck --esModuleInterop scripts/tests/test_appium_models_e2e.ts",
    "test:appium": "bun scripts/tests/test_appium_models_e2e.ts",
    "reset": "rm -rf ~/Library/Application\\ Support/taurscribe/settings.json ~/Library/Application\\ Support/Taurscribe/transcripts.db && echo 'Settings and history reset.'"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.2",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "webdriverio": "^9.31.9"
  }
}
